.asciimorph-selector {
  position: relative;
  width: min(100%, 34rem);
  color: #a6a6a6;
  font-size: 0.78rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.asciimorph-selector__label {
  display: block;
  margin-bottom: 8px;
  color: #8d99a6;
}

.ascii-menu-item {
  --menu-hover: rgba(45, 212, 191, 0.08);
  --menu-checked: rgba(52, 211, 153, 0.14);
  --menu-edge: rgba(45, 212, 191, 0.45);
  display: flex;
  width: 100%;
  align-items: center;
  gap: 0.7ch;
  border: 0;
  border-left: 2px solid transparent;
  background: transparent;
  padding: 8px 14px 8px 16px;  color: inherit;
  text-align: left;
  cursor: pointer;
  transition: background-color 80ms ease, border-color 80ms ease, filter 80ms ease, transform 80ms ease, box-shadow 80ms ease;
}

.ascii-menu-item--checked {
  background: var(--menu-checked);
  border-left-color: rgba(52, 211, 153, 0.72);
}

.ascii-menu-item:hover,
.ascii-menu-item:focus-visible {
  z-index: 1;
  background: var(--menu-hover);
  border-left-color: var(--menu-edge);
  transform: translateY(-2px);
  outline: none;
  filter: brightness(1.08);
  box-shadow: 2px 3px 0 rgba(0, 0, 0, 0.55);
}

.ascii-menu-marker {
  flex: 0 0 1.2ch;
  white-space: pre;
}

.asciimorph-selector__menu {  position: absolute;
  top: calc(100% + 4px);
  left: 0;
  z-index: 40;
  width: 100%;
  max-height: min(12rem, 36vh);
  overflow: hidden auto;
  overscroll-behavior: contain;
  border: 1px solid #2d2d2d;
  border-radius: 4px;
  background: rgba(0, 0, 0, 0.95);
  padding: 4px;
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.65);
  background-image: repeating-linear-gradient(
    to bottom,
    rgba(72, 90, 86, 0.16) 0,
    rgba(72, 90, 86, 0.16) 2px,
    transparent 2px,
    transparent 7px
  );
}

.asciimorph-selector__menu .ascii-menu-item {
  border-bottom: 1px solid rgba(92, 92, 92, 0.52);
  padding: 14px 18px;
  font-size: 0.88rem;
  letter-spacing: 0.12em;
}

.asciimorph-selector__menu .ascii-menu-item:last-child {
  border-bottom: 0;
}

.asciimorph-selector__menu .ascii-menu-item--checked {
  background: rgba(45, 212, 191, 0.82);
  color: #020403;
  border-left-color: #5ee4c8;
}
